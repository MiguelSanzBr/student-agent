# Raias paralelas de desenvolvimento: um projeto compose, três portas e um Postgres efêmero cada.
# Formato <RAIA>_<VAR>=valor; o Makefile carrega as variáveis da raia escolhida (LANE=a..d).
A_COMPOSE_PROJECT_NAME=sa-a
A_API_PORT=8010
A_DB_PORT=55432
A_REDIS_PORT=56379
B_COMPOSE_PROJECT_NAME=sa-b
B_API_PORT=8011
B_DB_PORT=55433
B_REDIS_PORT=56380
C_COMPOSE_PROJECT_NAME=sa-c
C_API_PORT=8012
C_DB_PORT=55434
C_REDIS_PORT=56381
D_COMPOSE_PROJECT_NAME=sa-d
D_API_PORT=8013
D_DB_PORT=55435
D_REDIS_PORT=56382
