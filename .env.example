# Opcional: sem chave a API roda em modo replay ("modo demonstração").
# O init-secrets copia esta chave para o volume do app a cada `docker compose up`.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Provedor: auto (anthropic > gemini > openai > replay, pela chave que houver), anthropic, gemini, openai, replay
# LLM_PROVIDER=auto
# Modelo; vazio = padrão do provedor (precisa ter cota em slo_targets.yaml).
# LLM_MODEL=
